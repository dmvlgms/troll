// =====================================================
// EEPROM LAYOUT
// addr 0-1 : dryVal  (int, 2 bytes)
// addr 2-3 : wetVal  (int, 2 bytes)
// addr 4   : magic   (byte = 0xAB → valid data written)
// =====================================================

#define EEPROM_SIZE  8
#define EEPROM_MAGIC 0xAB

void eepromSave() {
  EEPROM.put(0, dryVal);   // writes 2 bytes
  EEPROM.put(2, wetVal);   // writes 2 bytes
  EEPROM.write(4, EEPROM_MAGIC);
  EEPROM.commit();
  Serial.printf("[EEPROM] Saved  dry=%d  wet=%d\n", dryVal, wetVal);
}

void eepromLoad() {
  if (EEPROM.read(4) == EEPROM_MAGIC) {
    EEPROM.get(0, dryVal);
    EEPROM.get(2, wetVal);
    Serial.printf("[EEPROM] Loaded dry=%d  wet=%d\n", dryVal, wetVal);
  } else {
    Serial.println(F("[EEPROM] No saved calibration — using defaults"));
    // defaults already set at declaration
  }
}

