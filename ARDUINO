// =====================================================
// SENSOR
// =====================================================

int rawSample(int n = 10) {
  long total = 0;
  for (int i = 0; i < n; i++) {
    total += analogRead(MOISTURE_PIN);
    delay(5);
  }
  return (int)(total / n);
}

void readMoisture() {
  moistureRaw = rawSample();
  sensorOK    = (moistureRaw > 10 && moistureRaw < 1010);

  if (sensorOK) {
    smoothRaw   = (smoothRaw * 0.85f) + (moistureRaw * 0.15f);
    int pct     = map((int)smoothRaw, dryVal, wetVal, 0, 100);
    moisturePct = constrain(pct, 0, 100);
  }
}

// =====================================================
// LOW-LEVEL PUMP SWITCH  (always go through these)
// =====================================================

void _pumpOn() {
  if (!pumpActive) {
    pumpActive      = true;
    pumpStart       = millis();
    pumpOnStartedAt = millis();
    digitalWrite(PUMP_PIN, HIGH);
  }
}

void _pumpOff() {
  if (pumpActive) {
    pumpTimeAccumulate();
    pumpActive = false;
    digitalWrite(PUMP_PIN, LOW);
  }
}

// =====================================================
// AUTO PUMP LOGIC
//
//  Cycle 0  → pump ON for 10 s (first burst)
//             → pause 20–30 min (random soak)
//  Cycle 1  → if moisture still low: pump ON 5 s (top-up)
//             → pause 25 min cooldown, reset to cycle 0
//  At any point: if moisture rises above (minM + 5) pump stops early
// =====================================================

void controlPump() {
  unsigned long now = millis();

  // ── Manual-timer override ─────────────────────────────────
  if (manualMode) {
    if (now - manualStart >= manualDuration) {
      manualMode = false;
      _pumpOff();
    }
    return;
  }

  // ── Auto mode ─────────────────────────────────────────────
  int minM = plants[selectedPlant].minMoisture;

  if (pumpActive) {
    unsigned long elapsed  = now - pumpStart;
    unsigned long pulseLen = (waterCycle == 0) ? FIRST_PULSE_MS : SECOND_PULSE_MS;

    bool stopNow = !sensorOK
                || (moisturePct >= minM + 5)   // soil absorbed enough
                || (elapsed    >= pulseLen);    // time limit reached

    if (stopNow) {
      _pumpOff();

      if (waterCycle == 0) {
        // First 10-s burst complete → soak 20-30 min then follow-up
        waterCycle = 1;
        unsigned long soak = SOAK_MIN_MS
                           + (unsigned long)random(0L, (long)(SOAK_MAX_MS - SOAK_MIN_MS));
        pumpPauseUntil = now + soak;
        Serial.printf("[PUMP] 1st burst done. Soaking %lu min before follow-up.\n",
                      soak / 60000UL);
      } else {
        // Follow-up 5-s burst complete → long cooldown, fresh cycle
        waterCycle     = 0;
        pumpPauseUntil = now + POST_SECOND_MS;
        Serial.println(F("[PUMP] Follow-up done. 25-min cooldown. Cycle reset."));
      }
    }
    return;
  }

  // Pump is currently OFF ─────────────────────────────────────
  if (!sensorOK)           return;   // sensor fault — don't water
  if (now < pumpPauseUntil) return;  // still in soak / cooldown

  if (moisturePct >= minM) {
    // Soil is fine — if soak period just ended, reset cycle
    if (waterCycle == 1) {
      waterCycle = 0;
      Serial.println(F("[PUMP] Soak done, moisture OK. Cycle reset."));
    }
    return;
  }

  // Moisture still below threshold → trigger next burst
  Serial.printf("[PUMP] Moisture %d%% < %d%% — starting %s burst\n",
    moisturePct, minM, waterCycle == 0 ? "10s first" : "5s follow-up");
  _pumpOn();
}

// =====================================================
// PUMP HELPERS  (web / manual commands)
// =====================================================

void pumpOn() {
  manualMode     = false;
  pumpPauseUntil = 0;
  waterCycle     = 0;
  _pumpOn();
}

void pumpOff() {
  manualMode     = false;
  pumpPauseUntil = 0;
  _pumpOff();
}

void pumpTimer(int seconds) {
  pumpOff();
  manualMode     = true;
  manualStart    = millis();
  manualDuration = (unsigned long)seconds * 1000UL;
  _pumpOn();
}

// =====================================================
// CALIBRATION  (session-only — always 1024/294 on reboot)
// =====================================================

void handleCalibrateDry() {
  int s = rawSample(20);
  dryVal    = s;
  smoothRaw = (float)s;
  Serial.printf("[CAL] Session dry=%d\n", dryVal);
  server.send(200, "text/plain", String(dryVal));
}

void handleCalibrateWet() {
  int s = rawSample(20);
  wetVal    = s;
  smoothRaw = (float)s;
  Serial.printf("[CAL] Session wet=%d\n", wetVal);
  server.send(200, "text/plain", String(wetVal));
}

void handleCalibrateReset() {
  dryVal    = 1024;
  wetVal    = 294;
  smoothRaw = (float)rawSample();
  Serial.println(F("[CAL] Reset to defaults 1024/294"));
  server.send(200, "text/plain", "RESET");
}

// =====================================================
// OLED
// =====================================================

void updateOLED() {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  // Row 1 — plant name
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.print(plants[selectedPlant].oledName);

  // Row 2 — moisture %
  if (!sensorOK) {
    display.setTextSize(1);
    display.setCursor(0, 14);
    display.print("!! SENSOR ERROR !!");
  } else {
    display.setTextSize(2);
    display.setCursor(0, 12);
    display.print("Mst:");
    display.print(moisturePct);
    display.print("%");
  }

  // Row 3 — dry / wet / raw
  display.setTextSize(1);
  display.setCursor(0, 32);
  display.print("D:");
  display.print(dryVal);
  display.setCursor(48, 32);
  display.print("W:");
  display.print(wetVal);
  display.setCursor(94, 32);
  display.print("R:");
  display.print(moistureRaw);

  // Row 4 — pump state / soak countdown
  display.setCursor(0, 44);
  if (pumpActive) {
    display.print("PUMP ON ");
    display.print(waterCycle == 0 ? "10s" : "5s");
  } else if (millis() < pumpPauseUntil) {
    unsigned long rem = (pumpPauseUntil - millis()) / 1000;
    unsigned long m   = rem / 60;
    unsigned long s   = rem % 60;
    display.print("Soak ");
    display.print(m);
    display.print("m");
    display.print(s);
    display.print("s");
  } else {
    display.print("PUMP OFF");
  }

  // Row 5 — total pump working time
  display.setCursor(0, 56);
  display.print("Run:");
  display.print(formatTime(totalPumpSeconds()));

  display.display();
}

// =====================================================
// JSON DATA ENDPOINT
// =====================================================

void handleData() {
  unsigned long pauseRem = (millis() < pumpPauseUntil)
                           ? (pumpPauseUntil - millis()) / 1000
                           : 0;

  String json = "{";
  json += "\"moist\":"    + String(moisturePct)   + ",";
  json += "\"raw\":"      + String(moistureRaw)    + ",";
  json += "\"dry\":"      + String(dryVal)          + ",";
  json += "\"wet\":"      + String(wetVal)          + ",";
  json += "\"plant\":"    + String(selectedPlant)  + ",";
  json += "\"minM\":"     + String(plants[selectedPlant].minMoisture) + ",";
  json += "\"ok\":"       + (sensorOK   ? "true" : "false") + ",";
  json += "\"pump\":"     + (pumpActive ? "true" : "false") + ",";
  json += "\"cycle\":"    + String(waterCycle)     + ",";
  json += "\"pauseRem\":" + String(pauseRem)       + ",";
  json += "\"workSec\":"  + String(totalPumpSeconds()) + ",";
  json += "\"uptime\":"   + String(millis() / 1000);
  json += "}";
  server.send(200, "application/json", json);
}

