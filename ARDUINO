void handlePumpOn()  { pumpOn();  server.send(200, "text/plain", "ON");  }
void handlePumpOff() { pumpOff(); server.send(200, "text/plain", "OFF"); }

void handlePumpTimer() {
  int t = 10;
  if (server.hasArg("t")) t = server.arg("t").toInt();
  t = constrain(t, 1, 600);
  pumpTimer(t);
  server.send(200, "text/plain", "TIMER");
}

void handlePlantSelect() {
  if (server.hasArg("id")) {
    int id = server.arg("id").toInt();
    if (id >= 0 && id < PLANT_COUNT) {
      if (pumpActive && !manualMode) pumpOff();
      selectedPlant  = id;
      waterCycle     = 0;
      pumpPauseUntil = 0;
    }
  }
  server.send(200, "text/plain", "OK");
}

