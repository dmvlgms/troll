// =====================================================
// CALIBRATION HANDLERS
// =====================================================

// Call while sensor is in completely dry air / dry soil
void handleCalibrateDry() {
  int sample = rawSample(20);   // more samples = more stable
  if (sample <= 10 || sample >= 1010) {
    server.send(400, "text/plain", "SENSOR_ERROR");
    return;
  }
  dryVal    = sample;
  smoothRaw = (float)sample;   // reset filter to avoid stale offset
  eepromSave();
  Serial.printf("[CAL] New dry=%d\n", dryVal);
  server.send(200, "text/plain", String(dryVal));
}

// Call while sensor is fully submerged in water
void handleCalibrateWet() {
  int sample = rawSample(20);
  if (sample <= 10 || sample >= 1010) {
    server.send(400, "text/plain", "SENSOR_ERROR");
    return;
  }
  wetVal    = sample;
  smoothRaw = (float)sample;
  eepromSave();
  Serial.printf("[CAL] New wet=%d\n", wetVal);
  server.send(200, "text/plain", String(wetVal));
}

// Reset to factory defaults
void handleCalibrateReset() {
  dryVal = 800;
  wetVal = 450;
  smoothRaw = (float)rawSample();
  eepromSave();
  Serial.println(F("[CAL] Reset to defaults"));
  server.send(200, "text/plain", "RESET");
}

// =====================================================
