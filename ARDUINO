// =====================================================

int dryVal = 1024;   // raw ADC in dry air  (= 0%  moisture)
int wetVal = 294;    // raw ADC in water     (= 100% moisture)

// =====================================================
// SENSOR STATE
// =====================================================

int   moistureRaw = 0;
int   moisturePct = 0;
float smoothRaw   = 0.0f;
bool  sensorOK    = true;

// =====================================================
// PUMP TIMING CONFIG
// =====================================================

const unsigned long FIRST_PULSE_MS  = 10000UL;         // 10 s  — initial watering burst
const unsigned long SECOND_PULSE_MS =  5000UL;         //  5 s  — follow-up top-up burst
const unsigned long SOAK_MIN_MS     = 20UL * 60000UL;  // 20 min soak (minimum)
const unsigned long SOAK_MAX_MS     = 30UL * 60000UL;  // 30 min soak (maximum, randomised)
const unsigned long POST_SECOND_MS  = 25UL * 60000UL;  // cooldown after 2nd pulse

// =====================================================
// PUMP STATE
// =====================================================

bool          pumpActive     = false;
unsigned long pumpStart      = 0;
unsigned long pumpPauseUntil = 0;

// 0 = fresh cycle  → next ON burst is 10 s (first pulse)
// 1 = after first  → next ON burst is  5 s (follow-up pulse)
int waterCycle = 0;

bool          manualMode     = false;
unsigned long manualStart    = 0;
unsigned long manualDuration = 0;

// =====================================================
// WORKING-TIME TRACKER
// =====================================================

unsigned long pumpTotalOnMs   = 0;   // accumulated pump-ON time (ms)
unsigned long pumpOnStartedAt = 0;   // millis() when current ON period began

// Call whenever the pump turns OFF to credit the elapsed ON time
void pumpTimeAccumulate() {
  if (pumpOnStartedAt > 0) {
    pumpTotalOnMs  += millis() - pumpOnStartedAt;
    pumpOnStartedAt = 0;
  }
}

// Total seconds the pump has been ON (including current session if still running)
unsigned long totalPumpSeconds() {
  unsigned long ms = pumpTotalOnMs;
  if (pumpActive && pumpOnStartedAt > 0)
    ms += millis() - pumpOnStartedAt;
  return ms / 1000UL;
}

String formatTime(unsigned long secs) {
  unsigned long h = secs / 3600;
  unsigned long m = (secs % 3600) / 60;
  unsigned long s = secs % 60;
  char buf[20];
  if (h > 0) snprintf(buf, sizeof(buf), "%luh %02lum %02lus", h, m, s);
  else        snprintf(buf, sizeof(buf), "%lum %02lus", m, s);
  return String(buf);
}

