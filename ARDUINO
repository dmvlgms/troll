// =====================================================
// SENSOR
// =====================================================

// Take N samples quickly and return the average raw ADC
int rawSample(int n = 10) {
  long total = 0;
  for (int i = 0; i < n; i++) {
    total += analogRead(MOISTURE_PIN);
    delay(5);
  }
  return (int)(total / n);
}

void readMoisture() {
  moistureRaw = rawSample();
  sensorOK    = (moistureRaw > 10 && moistureRaw < 1010);

  if (sensorOK) {
    smoothRaw   = (smoothRaw * 0.85f) + (moistureRaw * 0.15f);
    int pct     = map((int)smoothRaw, dryVal, wetVal, 0, 100);
    moisturePct = constrain(pct, 0, 100);
  }
}

// =====================================================
// PUMP LOGIC
// =====================================================

void controlPump() {
  int minM = plants[selectedPlant].minMoisture;
  unsigned long maxMs = (unsigned long)plants[selectedPlant].maxWaterMin * 60000UL;

  if (!manualMode) {
    if (!pumpActive && sensorOK && moisturePct < minM) {
      pumpActive = true;
      pumpStart  = millis();
      digitalWrite(PUMP_PIN, HIGH);
    }
    if (pumpActive && (!sensorOK || moisturePct >= minM + 5)) {
      pumpActive = false;
      digitalWrite(PUMP_PIN, LOW);
    }
    if (pumpActive && (millis() - pumpStart >= maxMs)) {
      pumpActive = false;
      digitalWrite(PUMP_PIN, LOW);
      Serial.println(F("[SAFETY] Pump stopped - max runtime reached"));
    }
  }

  if (manualMode && (millis() - manualStart >= manualDuration)) {
    manualMode = false;
    pumpActive = false;
    digitalWrite(PUMP_PIN, LOW);
  }
}

// =====================================================
// PUMP HELPERS
// =====================================================

void pumpOn() {
  manualMode = false;
  pumpActive = true;
  pumpStart  = millis();
  digitalWrite(PUMP_PIN, HIGH);
}

void pumpOff() {
  manualMode = false;
  pumpActive = false;
  digitalWrite(PUMP_PIN, LOW);
}

void pumpTimer(int seconds) {
  manualMode     = true;
  manualStart    = millis();
  manualDuration = (unsigned long)seconds * 1000UL;
  pumpActive     = true;
  pumpStart      = millis();
  digitalWrite(PUMP_PIN, HIGH);
}

// =====================================================
// OLED
// =====================================================

void updateOLED() {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(1);
  display.setCursor(0, 0);
  display.print(plants[selectedPlant].oledName);

  if (!sensorOK) {
    display.setTextSize(1);
    display.setCursor(0, 18);
    display.print("!! SENSOR ERROR !!");
  } else {
    display.setTextSize(2);
    display.setCursor(0, 18);
    display.print("Moist:");
    display.print(moisturePct);
    display.print("%");
  }

  display.setTextSize(1);
  display.setCursor(0, 42);
  display.print("D:");
  display.print(dryVal);
  display.setCursor(50, 42);
  display.print("W:");
  display.print(wetVal);
  display.setCursor(95, 42);
  display.print("R:");
  display.print(moistureRaw);

  display.setCursor(0, 56);
  display.print(pumpActive ? "PUMP ON" : "PUMP OFF");

  display.display();
}

