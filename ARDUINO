      if (i < PLANT_COUNT - 1) js += ",";
    }
    js += "];";
    server.sendContent(js);
  }

  // ── CHUNK 9: JS — static logic ──────────────────────────────
  server.sendContent(F(
    "const CIRC=471.24;"

    // generic fetch + refresh
    "async function cmd(u){await fetch(u);ref();}"

    // flash notification
    "function flash(msg,col){"
      "let f=document.getElementById('flash');"
      "f.textContent=msg;"
      "f.style.background=col||'#1a3322';"
      "f.style.color='#4ade80';"
      "f.style.opacity='1';"
      "setTimeout(()=>f.style.opacity='0',2200);"
    "}"

    // plant selector
    "async function selp(id){"
      "document.querySelectorAll('.pb').forEach((b,i)=>{"
        "b.className='pb'+(i===id?' active':'');"
      "});"
      "document.getElementById('gname').textContent=NAMES[id];"
      "document.getElementById('note').innerHTML="
        "'Auto-water when moisture &lt; <b>'+MINS[id]+'%</b> &bull; Plant: '+NAMES[id];"
      "await fetch('/plant?id='+id);"
    "}"

    // calibration
    "async function calDry(){"
      "let r=await fetch('/calibrate/dry');"
      "if(r.ok){let v=await r.text();"
        "document.getElementById('cv-dry-n').textContent=v;"
        "flash('DRY saved: '+v,'#0f2010');"
        "ref();"
      "}else flash('Sensor error!','#1a0808');"
    "}"
    "async function calWet(){"
      "let r=await fetch('/calibrate/wet');"
      "if(r.ok){let v=await r.text();"
        "document.getElementById('cv-wet-n').textContent=v;"
        "flash('WET saved: '+v,'#080e18');"
        "ref();"
      "}else flash('Sensor error!','#1a0808');"
    "}"
    "async function calReset(){"
      "await fetch('/calibrate/reset');"
      "document.getElementById('cv-dry-n').textContent='800';"
      "document.getElementById('cv-wet-n').textContent='450';"
      "flash('Reset to defaults','#111111');"
      "ref();"
    "}"

    // update all live elements
    "function setData(d){"
      "let ok=d.ok;"
      "let c=!ok?'#a855f7':d.moist<20?'#f87171':d.moist<40?'#fb923c':d.moist<60?'#fbd34d':'#4ade80';"
      "let arc=document.getElementById('arc');"
      "arc.style.strokeDashoffset=ok?CIRC*(1-d.moist/100):CIRC;"
      "arc.style.stroke=c;"
      "let pt=document.getElementById('pct');"
      "pt.textContent=ok?d.moist+'%':'---';"
      "pt.style.fill=c;"
      "let cls=ok?(d.pump?'on':'off'):'err';"
      "let txt=ok?(d.pump?'Pump ACTIVE':'Pump STOPPED'):'Sensor Error';"
      "document.getElementById('pill').className='pill '+cls;"
      "document.getElementById('dot').className='dot '+cls;"
      "document.getElementById('pstatus').textContent=txt;"
      // update raw bars
      "document.getElementById('cv-raw-n').textContent=d.raw;"
      "document.getElementById('cv-dry-n').textContent=d.dry;"
      "document.getElementById('cv-wet-n').textContent=d.wet;"
      "let rv=document.getElementById('rawv');"
      "rv.textContent='RAW '+d.raw;"
      "rv.className=ok?'':'warn';"
    "}"

    "async function ref(){"
      "try{let r=await fetch('/data');let d=await r.json();setData(d);}catch(e){}"
    "}"
    "ref();setInterval(ref,2000);"
    "</script></body></html>"
  ));
}

// =====================================================
// SETUP
// =====================================================

void setup() {
  Serial.begin(115200);

  pinMode(PUMP_PIN, OUTPUT);
  digitalWrite(PUMP_PIN, LOW);

  Wire.begin(12, 14);
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();

  EEPROM.begin(EEPROM_SIZE);
  eepromLoad();   // overwrite defaults with saved calibration if present

  // Seed smoothing filter with real reading after calibration is loaded
  smoothRaw = (float)analogRead(MOISTURE_PIN);

  WiFi.softAP(AP_NAME, AP_PASS);
  MDNS.begin("kwtsos");

  server.on("/",                handleRoot);
  server.on("/data",            handleData);
  server.on("/plant",           handlePlantSelect);
  server.on("/pump/on",         handlePumpOn);
  server.on("/pump/off",        handlePumpOff);
  server.on("/pump/timer",      handlePumpTimer);
  server.on("/calibrate/dry",   handleCalibrateDry);
  server.on("/calibrate/wet",   handleCalibrateWet);
  server.on("/calibrate/reset", handleCalibrateReset);

  server.begin();

  Serial.println(F("\n=== Kwtsos Smart Farm ==="));
  Serial.printf("AP: %s  IP: %s  Plants: %d\n",
    AP_NAME, WiFi.softAPIP().toString().c_str(), PLANT_COUNT);
  Serial.printf("Calibration: dry=%d  wet=%d\n", dryVal, wetVal);
}

// =====================================================
// LOOP
// =====================================================

void loop() {
  server.handleClient();
  MDNS.update();

  if (millis() - lastRead > 2000) {
    lastRead = millis();
    readMoisture();
    controlPump();
    updateOLED();

    Serial.printf("[%s] Moisture: %d%% (raw:%d dry:%d wet:%d) | Pump: %s%s\n",
      plants[selectedPlant].oledName,
      moisturePct, moistureRaw, dryVal, wetVal,
      pumpActive ? "ON"  : "OFF",
      sensorOK   ? ""    : " *** SENSOR ERROR ***"
    );
  }
}
