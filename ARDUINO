          " stroke-dashoffset='" + String(offset) + "'"
          " stroke-linecap='round' transform='rotate(-90 90 90)'/>";
    gc += "<text id='pct' x='90' y='83' text-anchor='middle'"
          " fill='" + col + "'"
          " font-family='Georgia,serif' font-size='44' font-style='italic'>";
    gc += sensorOK ? (String(moisturePct) + "%") : String("---");
    gc += "</text>";
    gc += "<text x='90' y='104' text-anchor='middle' fill='#3a6647'"
          " font-family='Trebuchet MS,sans-serif' font-size='9' letter-spacing='3'>MOISTURE</text>";
    gc += "<text id='gname' x='90' y='120' text-anchor='middle' fill='#1e4228'"
          " font-family='Trebuchet MS,sans-serif' font-size='9'>";
    gc += plants[selectedPlant].name;
    gc += "</text></svg>";

    String cls = sensorOK ? pumpCls : "err";
    String txt = sensorOK ? pumpTxt : "Sensor Error";
    gc += "<div><span class='pill " + cls + "' id='pill'>";
    gc += "<span class='dot " + cls + "' id='dot'></span>";
    gc += "<span id='pstatus'>" + txt + "</span>";
    gc += "</span></div>";

    // Soak countdown
    String soakVis = (pauseRemSec > 0 && !pumpActive) ? " vis" : "";
    gc += "<div class='soakbar" + soakVis + "' id='soakbar'>";
    gc += "&#128167; Soaking — next check in <span id='soakcnt'>";
    gc += String(pauseRemSec);
    gc += "</span>s</div>";

    gc += "</div>"; // .gcard
    server.sendContent(gc);
  }

  // ── CHUNK 5: STATS CARD ──────────────────────────────────────
  {
    unsigned long warnThresholdH = 100; // flag if pump ran > 100 hours total
    bool workWarn = totalPumpSeconds() > warnThresholdH * 3600UL;

    String sc = "<div class='statcard'>";
    sc += "<div class='clabel'>System Stats</div>";
    sc += "<div class='statrow'>";

    // Pump working time
    sc += "<div class='stat" + String(workWarn ? " warn" : "") + "'>";
    sc += "<div class='slbl'>Pump Run Time</div>";
    sc += "<div class='sval' id='worktime'>" + formatTime(totalPumpSeconds()) + "</div></div>";

    // Uptime
    sc += "<div class='stat'><div class='slbl'>Uptime</div>";
    sc += "<div class='sval' id='uptimeval'>" + formatTime(millis() / 1000) + "</div></div>";

    // Water cycle state
    sc += "<div class='stat'><div class='slbl'>Next Burst</div>";
    sc += "<div class='sval' id='cyclestat'>";
    if (pumpActive)             sc += waterCycle == 0 ? "10s NOW" : "5s NOW";
    else if (pauseRemSec > 0)   sc += waterCycle == 1 ? "5s top-up" : "10s fresh";
    else                        sc += waterCycle == 0 ? "10s fresh" : "5s top-up";
    sc += "</div></div>";

    sc += "</div></div>"; // .statrow + .statcard
    server.sendContent(sc);
  }

  // ── CHUNK 6: CALIBRATION CARD ────────────────────────────────
  {
    String cc = "<div class='calcard'>";
    cc += "<div class='clabel'>Sensor Calibration";
    cc += "<span style='color:#1e3a24;font-size:9px;margin-left:8px'>"
          "session-only &mdash; 1024/294 on reboot</span></div>";
    cc += "<div class='calbar'>";
    cc += "<div class='calval' id='cv-dry'><div class='lbl'>DRY</div>"
          "<div class='num' id='cv-dry-n'>" + String(dryVal) + "</div></div>";
    cc += "<div class='calval' id='cv-raw'><div class='lbl'>RAW NOW</div>"
          "<div class='num' id='cv-raw-n'>" + String(moistureRaw) + "</div></div>";
    cc += "<div class='calval' id='cv-wet'><div class='lbl'>WET</div>"
          "<div class='num' id='cv-wet-n'>" + String(wetVal) + "</div></div>";
    cc += "</div>";
    cc += "<div class='cal-btns'>";
    cc += "<button class='btn-dry' onclick='calDry()'>&#9729; Set as DRY</button>";
    cc += "<button class='btn-wet' onclick='calWet()'>&#128167; Set as WET</button>";
    cc += "</div>";
    cc += "<button class='btn-rst' onclick='calReset()'>&#8635; Reset to defaults (1024/294)</button>";
    cc += "<div class='hint'>1. Sensor in open air &rarr; SET DRY<br>"
          "2. Sensor tip in water &rarr; SET WET<br>"
          "Always starts at 1024/294 after reboot.</div>";
    cc += "</div>";
    server.sendContent(cc);
  }

  // ── CHUNK 7: PUMP CONTROLS ───────────────────────────────────
  server.sendContent(F(
    "<div class='ccard'>"
    "<div class='clabel'>Pump Control</div>"
    "<div class='btns'>"
    "<button class='btn btn-on'  onclick=\"cmd('/pump/on')\">&#128167; Pump ON</button>"
    "<button class='btn btn-off' onclick=\"cmd('/pump/off')\">&#128721; Pump OFF</button>"
    "</div>"
    "<div class='trow'>"
    "<input id='t' type='number' min='1' max='600' placeholder='Duration in seconds...'>"
    "<button class='btn-t'"
      " onclick=\"cmd('/pump/timer?t='+document.getElementById('t').value)\">"
      "&#9201; Timer</button>"
    "</div>"
  ));

  // ── CHUNK 8: NOTE + RAW BAR ──────────────────────────────────
  {
    String tail = "<div class='note' id='note'>";
    tail += "Auto-water when moisture &lt; <b>";
    tail += plants[selectedPlant].minMoisture;
    tail += "%</b> &bull; 10s burst &rarr; soak 20&ndash;30 min &rarr; 5s top-up";
    tail += " &bull; Plant: " + String(plants[selectedPlant].name);
    tail += "</div></div>"; // .note + .ccard

    tail += "<div class='rawbar'>";
    tail += "<span id='rawv'" + String(!sensorOK ? " class='warn'" : "");
    tail += ">RAW " + String(moistureRaw) + "</span>";
    tail += "<span>DRY " + String(dryVal) + "</span>";
    tail += "<span>WET " + String(wetVal) + "</span>";
    tail += "</div>";
    tail += "</div>"; // .wrap
    server.sendContent(tail);
  }

  // ── CHUNK 9: JS — dynamic arrays ─────────────────────────────
  {
    String js = "<script>const MINS=[";
    for (int i = 0; i < PLANT_COUNT; i++) {
      js += plants[i].minMoisture;
      if (i < PLANT_COUNT - 1) js += ",";
    }
    js += "];const NAMES=[";
    for (int i = 0; i < PLANT_COUNT; i++) {
      js += "'"; js += plants[i].name; js += "'";
      if (i < PLANT_COUNT - 1) js += ",";
    }
    js += "];";
    server.sendContent(js);
  }

  // ── CHUNK 10: JS — static logic ──────────────────────────────
  server.sendContent(F(
    "const CIRC=471.24;"

    "async function cmd(u){await fetch(u);ref();}"

    "function flash(msg,col){"
      "let f=document.getElementById('flash');"
      "f.textContent=msg;f.style.background=col||'#1a3322';"
      "f.style.color='#4ade80';f.style.opacity='1';"
      "setTimeout(()=>f.style.opacity='0',2200);"
    "}"

    "async function selp(id){"
      "document.querySelectorAll('.pb').forEach((b,i)=>{"
        "b.className='pb'+(i===id?' active':'');"
      "});"
      "document.getElementById('gname').textContent=NAMES[id];"
      "document.getElementById('note').innerHTML="
        "'Auto-water when moisture &lt; <b>'+MINS[id]"
        "+'%</b> &bull; 10s burst &rarr; soak 20&ndash;30 min &rarr; 5s top-up"
        " &bull; Plant: '+NAMES[id];"
      "await fetch('/plant?id='+id);"
    "}"

    // calibration
    "async function calDry(){"
      "let r=await fetch('/calibrate/dry');"
      "if(r.ok){let v=await r.text();"
        "document.getElementById('cv-dry-n').textContent=v;"
        "flash('DRY set: '+v,'#0f2010');ref();"
      "}else flash('Sensor error!','#1a0808');"
    "}"
    "async function calWet(){"
      "let r=await fetch('/calibrate/wet');"
      "if(r.ok){let v=await r.text();"
        "document.getElementById('cv-wet-n').textContent=v;"
        "flash('WET set: '+v,'#080e18');ref();"
      "}else flash('Sensor error!','#1a0808');"
    "}"
    "async function calReset(){"
      "await fetch('/calibrate/reset');"
      "document.getElementById('cv-dry-n').textContent='1024';"
      "document.getElementById('cv-wet-n').textContent='294';"
      "flash('Reset to 1024/294','#111111');ref();"
    "}"

    // time formatter
    "function fmtTime(s){"
      "let h=Math.floor(s/3600);"
      "let m=Math.floor((s%3600)/60);"
      "let sec=s%60;"
      "if(h>0)return h+'h '+String(m).padStart(2,'0')+'m '+String(sec).padStart(2,'0')+'s';"
      "return m+'m '+String(sec).padStart(2,'0')+'s';"
    "}"

    // update all live elements
    "function setData(d){"
      "let ok=d.ok;"
      "let c=!ok?'#a855f7':d.moist<20?'#f87171':d.moist<40?'#fb923c'"
             ":d.moist<60?'#fbd34d':'#4ade80';"
      // gauge arc
      "let arc=document.getElementById('arc');"
      "arc.style.strokeDashoffset=ok?CIRC*(1-d.moist/100):CIRC;"
      "arc.style.stroke=c;"
      "let pt=document.getElementById('pct');"
      "pt.textContent=ok?d.moist+'%':'---';pt.style.fill=c;"
      // pump pill
      "let soaking=!d.pump&&d.pauseRem>0;"
      "let cls=!ok?'err':d.pump?'on':soaking?'soak':'off';"
      "let txt=!ok?'Sensor Error':d.pump"
        "?(d.cycle===0?'Watering 10s...':'Follow-up 5s...')"
        ":soaking?'Soaking...':'Pump STOPPED';"
      "document.getElementById('pill').className='pill '+cls;"
      "document.getElementById('dot').className='dot '+cls;"
      "document.getElementById('pstatus').textContent=txt;"
      // soak countdown
      "let sb=document.getElementById('soakbar');"
      "let sc=document.getElementById('soakcnt');"
      "if(soaking){sb.className='soakbar vis';sc.textContent=d.pauseRem;}"
      "else sb.className='soakbar';"
      // calibration values
      "document.getElementById('cv-raw-n').textContent=d.raw;"
      "document.getElementById('cv-dry-n').textContent=d.dry;"
      "document.getElementById('cv-wet-n').textContent=d.wet;"
      "let rv=document.getElementById('rawv');"
      "rv.textContent='RAW '+d.raw;rv.className=ok?'':'warn';"
      // stats
      "document.getElementById('worktime').textContent=fmtTime(d.workSec);"
      "document.getElementById('uptimeval').textContent=fmtTime(d.uptime);"
      // next burst label
      "let nb='';"
      "if(d.pump)            nb=d.cycle===0?'10s NOW':'5s NOW';"
      "else if(d.pauseRem>0) nb=d.cycle===1?'5s top-up':'10s fresh';"
      "else                  nb=d.cycle===0?'10s fresh':'5s top-up';"
      "document.getElementById('cyclestat').textContent=nb;"
    "}"

    "async function ref(){"
      "try{let r=await fetch('/data');let d=await r.json();setData(d);}catch(e){}"
    "}"
    "ref();setInterval(ref,2000);"
    "</script></body></html>"
  ));
}

// =====================================================
// SETUP
// =====================================================

void setup() {
  Serial.begin(115200);

  pinMode(PUMP_PIN, OUTPUT);
  digitalWrite(PUMP_PIN, LOW);

  Wire.begin(12, 14);
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();

  // Calibration always resets to factory defaults on every boot
  dryVal = 1024;
  wetVal = 294;

  randomSeed(analogRead(MOISTURE_PIN));          // seed RNG for soak randomisation
  smoothRaw = (float)analogRead(MOISTURE_PIN);   // seed smoothing filter

  WiFi.softAP(AP_NAME, AP_PASS);
  MDNS.begin("kwtsos");

  server.on("/",                handleRoot);
  server.on("/data",            handleData);
  server.on("/plant",           handlePlantSelect);
  server.on("/pump/on",         handlePumpOn);
  server.on("/pump/off",        handlePumpOff);
  server.on("/pump/timer",      handlePumpTimer);
  server.on("/calibrate/dry",   handleCalibrateDry);
  server.on("/calibrate/wet",   handleCalibrateWet);
  server.on("/calibrate/reset", handleCalibrateReset);

  server.begin();

  Serial.println(F("\n=== Kwtsos Smart Farm ==="));
  Serial.printf("AP: %s  IP: %s  Plants: %d\n",
    AP_NAME, WiFi.softAPIP().toString().c_str(), PLANT_COUNT);
  Serial.println(F("Calibration: dry=1024 wet=294 (fixed defaults, resets every boot)"));
  Serial.println(F("Watering: 10s burst -> 20-30min soak -> 5s top-up -> 25min cooldown"));
}

// =====================================================
// LOOP
// =====================================================

void loop() {
  server.handleClient();
  MDNS.update();

  if (millis() - lastRead > 2000) {
    lastRead = millis();
    readMoisture();
    controlPump();
    updateOLED();

    unsigned long pauseRem = (millis() < pumpPauseUntil)
                             ? (pumpPauseUntil - millis()) / 1000 : 0;

    Serial.printf(
      "[%s] Moist:%d%% raw:%d | Pump:%s cycle:%d soak_rem:%lus | RunTime:%s Uptime:%s\n",
      plants[selectedPlant].oledName,
      moisturePct, moistureRaw,
      pumpActive ? "ON" : "OFF",
      waterCycle,
      pauseRem,
      formatTime(totalPumpSeconds()).c_str(),
      formatTime(millis() / 1000).c_str()
    );
  }
}
